<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Katey.Core</RootNamespace>
    <Description>Elite Dangerous engineering domain: the blueprint, experimental, module-type, engineer and material catalog, plans, material totals, engineer coverage and EDSY import. No UI, no file IO beyond its embedded data.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The data tables ship inside the assembly, so the catalog is always present and always the
         version the code was built against. -->
    <EmbeddedResource Include="Data\*.json" LogicalName="Katey.Core.Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
