<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Katey.Ui"
        x:Class="Katey.Ui.RailWindow"
        Title="Elite Dangerous - Katey Live"
        Icon="avares://katey/Assets/katey.ico"
        Width="380" Height="720" MinWidth="300" MinHeight="400"
        Topmost="True"
        Background="#0C121B"
        FontFamily="{StaticResource BodyFont}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36">
  <Grid RowDefinitions="Auto,*">
    <!-- The drag strip stands in for the title bar; closing docks the rail again. With click-through on, nothing here can be pressed, so the close button hides. -->
    <Border Classes="rail" PointerPressed="StripPressed" Height="36" Padding="14,0,4,0" BorderBrush="{StaticResource RailLine}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="{StaticResource RailAccent}" IsVisible="{Binding IsLive}" />
          <Ellipse Width="8" Height="8" Fill="{StaticResource RailMuted}" IsVisible="{Binding !IsLive}" />
          <TextBlock Classes="live" Text="KATEY LIVE" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Classes="caption rail close" Click="CloseWindow" IsVisible="{Binding ShowsControls}" ToolTip.Tip="Bring the rail back into the main window">
          <Path Classes="glyph" Data="M0,0 L10,10 M10,0 L0,10" />
        </Button>
      </Grid>
    </Border>
    <ui:RailView Grid.Row="1" />
  </Grid>
</Window>
