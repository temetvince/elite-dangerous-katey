<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Katey.Ui.Text"
             xmlns:ui="using:Katey.Ui"
             xmlns:rail="using:Katey.App.Rail"
             x:Class="Katey.Ui.RailView">
  <!-- DataContext is a RailViewModel. The same instance backs the docked rail and the detached window.
       The ground is painted only as far as the content reaches, so in overlay mode the window below the last line is clear. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Background="Transparent">
    <Border Classes="rail" VerticalAlignment="Top">
      <StackPanel>
        <!-- Docked only: the rail's own window carries the live mark in its drag strip instead. -->
        <Border Classes="rsec" Padding="14,10,14,10" IsVisible="{Binding !IsDetached}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Classes="pulse" Width="8" Height="8" Fill="{StaticResource RailAccent}" IsVisible="{Binding IsLive}" />
              <Ellipse Width="8" Height="8" Fill="{StaticResource RailMuted}" IsVisible="{Binding !IsLive}" />
              <TextBlock Classes="live" Text="{loc:T Rail.Live, Upper=True}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowsControls}">
              <Button Content="{loc:T Rail.PopOut}" Command="{Binding DetachCommand}" IsVisible="{Binding !IsDetached}" />
              <Button Content="{loc:T Rail.BringBackShort}" Command="{Binding AttachCommand}" IsVisible="{Binding IsDetached}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Classes="rsec" IsVisible="{Binding !IsLive}">
          <TextBlock Classes="warn" Text="{Binding NotLiveText}" />
        </Border>

        <!-- While the history replays, only its progress shows: nothing below is the latest state yet. -->
        <Border Classes="rsec" IsVisible="{Binding IsCatchingUp}">
          <StackPanel Spacing="6">
            <TextBlock Classes="sub" TextWrapping="Wrap" Text="{Binding CatchUpText}" />
            <ProgressBar Classes="meter catchup" Value="{Binding CatchUpFraction}" IsIndeterminate="{Binding IsCatchUpIndeterminate}" />
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding !IsCatchingUp}">
        <!-- Position -->
        <Border Classes="rsec">
          <StackPanel Spacing="6">
            <TextBlock Classes="eyebrow accent" Text="{loc:T Column.Position, Upper=True}" />
            <Button Classes="link quiet" Command="{Binding SystemLink.OpenCommand}" IsVisible="{Binding ShowsControls}"><TextBlock Classes="big" Text="{Binding SystemName}" /></Button>
            <TextBlock Classes="big" Text="{Binding SystemName}" IsVisible="{Binding !ShowsControls}" />
            <TextBlock Classes="sub" Text="{Binding PositionDetail}" />
          </StackPanel>
        </Border>

        <!-- The route and the plot show while the drive charges and through the jump; the bodies otherwise, with the route in one line above them. -->
        <StackPanel IsVisible="{Binding ShowsRoute}">
        <!-- Route -->
        <Border Classes="rsec">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="{Binding RouteHeading}" />
              <StackPanel Grid.Column="1" IsVisible="{Binding ShowsControls}">
                <Button Classes="link" Content="{Binding RouteLink.Label}" Command="{Binding RouteLink.OpenCommand}" IsVisible="{Binding HasRoute}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding RouteStops}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="18,42,*,Auto" Margin="0,2">
                    <Ellipse Classes="dot" Classes.here="{Binding IsHere}" Classes.scoop="{Binding IsScoopable}" Classes.engineer="{Binding HasEngineer}" Fill="{Binding StarClass, Converter={StaticResource StarBrush}}" />
                    <TextBlock Grid.Column="1" Classes="mono sub" Text="{Binding Marker}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2">
                      <Button Classes="link ink" Content="{Binding Link.Label}" Command="{Binding Link.OpenCommand}" IsVisible="{Binding $parent[ItemsControl].DataContext.ShowsControls}" />
                      <TextBlock Text="{Binding Link.Label}" IsVisible="{Binding !$parent[ItemsControl].DataContext.ShowsControls}" />
                      <TextBlock Classes="sub" Text="{Binding StarText}" />
                      <StackPanel IsVisible="{Binding HasEngineer}">
                        <ContentControl Content="{Binding Engineer}" IsVisible="{Binding $parent[ItemsControl].DataContext.ShowsControls}" HorizontalAlignment="Left" />
                        <TextBlock Classes="accent" Text="{Binding Engineer.Name}" IsVisible="{Binding !$parent[ItemsControl].DataContext.ShowsControls}" />
                      </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="3" Classes="tag" IsVisible="{Binding IsScoopable}"><TextBlock Text="{loc:T Rail.Scoop}" /></Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:PhraseBlock Classes="sub" Parts="{Binding RouteRestParts}" />
            <TextBlock Classes="sub" Text="{Binding TravelledText}" />
            <!-- The tank: label and figures on one line, the bar full width beneath. The bar is drawn as the HUD draws it: blue to the tank's level under orange to the level after the next jump, so the blue that shows is the jump's burn. -->
            <StackPanel Spacing="4" IsVisible="{Binding Fuel.HasTank}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Classes="eyebrow" Text="{loc:T Column.Tank, Upper=True}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="mono sub" Text="{Binding Fuel.TankText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Classes="mono burn" Text="{Binding Fuel.NextJumpText}" IsVisible="{Binding Fuel.HasNextJump}" VerticalAlignment="Center" />
              </Grid>
              <Panel>
                <ProgressBar Classes="meter tall burn" Value="{Binding Fuel.TankFraction}" />
                <ProgressBar Classes="meter tall over" Classes.warn="{Binding Fuel.TankIsLow}" Value="{Binding Fuel.TankAfterJumpFraction}" />
              </Panel>
            </StackPanel>
            <ui:PhraseBlock Classes="sub" Parts="{Binding FuelParts}" />
            <ui:PhraseBlock Classes="warn" Parts="{Binding Fuel.SummaryParts}" IsVisible="{Binding !!Fuel.SummaryParts.Count}" />
          </StackPanel>
        </Border>

        <!-- Spansh plot -->
        <Border Classes="rsec" IsVisible="{Binding HasPlot}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="{loc:T Rail.SpanshPlot, Upper=True}" />
              <Button Grid.Column="1" Classes="link" Content="{loc:T Rail.FullPlot}" Command="{Binding PlotLink.OpenCommand}" IsVisible="{Binding ShowsControls}" />
            </Grid>
            <TextBlock Classes="sub" TextWrapping="Wrap" Text="{Binding PlotText}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasNextWaypoint}">
              <Button Content="{loc:T Common.CopyNextWaypoint}" Click="CopyNextWaypoint" IsVisible="{Binding ShowsControls}" />
              <TextBlock Name="PlotCopyStatus" Classes="sub" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsBodies}">
        <!-- This system -->
        <Border Classes="rsec">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Panel Width="22" Height="22" VerticalAlignment="Center">
                <Arc Classes="scan track" />
                <Arc Classes="scan" Classes.good="{Binding IsFullyScanned}" SweepAngle="{Binding ScanFraction, Converter={StaticResource Scale}, ConverterParameter=360}" />
              </Panel>
              <TextBlock Grid.Column="1" Classes="eyebrow" Classes.accent="{Binding !IsFullyScanned}" Classes.good="{Binding IsFullyScanned}" Text="{Binding SystemHeading}" VerticalAlignment="Center" />
            </Grid>
            <ui:PhraseBlock Classes="sub" Parts="{Binding RouteSummaryParts}" IsVisible="{Binding HasRoute}" />
            <TextBlock Classes="sub" TextWrapping="Wrap" Text="{Binding ValueText}" />
            <StackPanel Spacing="6" IsVisible="{Binding ShowsControls}">
              <!-- What the list is for: every landable body, the bodies with life, or the bodies with materials; nearest first in each. -->
              <StackPanel Orientation="Horizontal" Spacing="12">
                <RadioButton GroupName="bodyView" Content="{loc:T Rail.Landable}" IsChecked="{Binding ShowsLandable, Mode=OneWay}" Command="{Binding ShowViewCommand}" CommandParameter="{x:Static rail:RailBodyView.Landable}" />
                <RadioButton GroupName="bodyView" Content="{loc:T Rail.Biology}" IsChecked="{Binding ShowsBiology, Mode=OneWay}" Command="{Binding ShowViewCommand}" CommandParameter="{x:Static rail:RailBodyView.Biology}" />
                <RadioButton GroupName="bodyView" Content="{loc:T Rail.Minerals}" IsChecked="{Binding ShowsMinerals, Mode=OneWay}" Command="{Binding ShowViewCommand}" CommandParameter="{x:Static rail:RailBodyView.Minerals}" />
              </StackPanel>
              <!-- Which bodies with life to leave out: one choice of two, remembered; only the Biology view asks. -->
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsBiologyView}">
                <RadioButton GroupName="bodyFilter" Content="{loc:T Rail.AllLife}" IsChecked="{Binding ShowsAll, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="{x:Static rail:BodyFilter.All}" />
                <RadioButton GroupName="bodyFilter" Content="{loc:T Rail.SkipBacteria}" IsChecked="{Binding SkipsBacteria, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="{x:Static rail:BodyFilter.SkipBacteria}" />
              </StackPanel>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Bodies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource RailLine}" BorderThickness="0,0,0,1" Padding="0,6">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="mono" Text="{Binding Name}" />
                        <TextBlock Classes="accent" Text="{Binding ValueText}" IsVisible="{Binding !!ValueText.Length}" />
                        <Border Classes="tag accent" IsVisible="{Binding HasBiology}"><TextBlock Text="{Binding BiologyTag}" /></Border>
                        <Border Classes="tag good" IsVisible="{Binding Landable}"><TextBlock Text="{loc:T Common.Landable}" /></Border>
                        <Border Classes="tag" IsVisible="{Binding IsHighGravity}"><TextBlock Text="{Binding Gravity}" /></Border>
                        <Border Classes="tag bad" IsVisible="{Binding IsExtremeGravity}"><TextBlock Text="{Binding Gravity}" /></Border>
                        <Border Classes="tag" IsVisible="{Binding HasShortMaterial}"><TextBlock Text="{loc:T Rail.Needed}" /></Border>
                        <Border Classes="tag" IsVisible="{Binding IsLanded}"><TextBlock Text="{loc:T Rail.Landed}" /></Border>
                      </StackPanel>
                      <TextBlock Classes="sub" Text="{Binding Signals}" IsVisible="{Binding Signals.Length}" />
                      <TextBlock Text="{Binding Life}" IsVisible="{Binding LifeVisible}" />
                      <!-- Once probed: the genera richest first, the likeliest species beside each, the pay with the bonus at the right. -->
                      <ItemsControl ItemsSource="{Binding GenusRows}" IsVisible="{Binding GeneraVisible}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="8">
                              <!-- Violet after the first sample, blue after the second, green once all three are taken. -->
                              <TextBlock Text="{Binding Name}" Classes.first="{Binding IsFirstSample}" Classes.burn="{Binding IsSecondSample}" Classes.good="{Binding IsComplete}" />
                              <TextBlock Grid.Column="1" Classes="sub" Classes.first="{Binding IsFirstSample}" Classes.burn="{Binding IsSecondSample}" Classes.good="{Binding IsComplete}" Text="{Binding Species}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="2" Classes="mono" Classes.first="{Binding IsFirstSample}" Classes.burn="{Binding IsSecondSample}" Classes.good="{Binding IsComplete}" Text="{Binding ValueText}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="sub" Text="{Binding Materials}" IsVisible="{Binding MaterialsVisible}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="sub" Text="{Binding BodiesNote}" IsVisible="{Binding BodiesNote.Length}" />
          </StackPanel>
        </Border>

        </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
