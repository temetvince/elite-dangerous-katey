<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Katey.Ui.PageHeaderView"
             x:Name="Root">
  <!-- DataContext is a Page: the breadcrumb links, the kicker and the title, with whatever the page puts Beside the title. -->
  <StackPanel Spacing="4">
    <StackPanel Orientation="Horizontal" Spacing="6">
      <ItemsControl ItemsSource="{Binding Breadcrumbs}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="link crumb" Content="{Binding Label}" Command="{Binding OpenCommand}" />
              <TextBlock Classes="kicker" Text="·" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="kicker" Text="{Binding Kicker}" IsVisible="{Binding HasKicker}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center" />
      <ContentPresenter Content="{Binding #Root.Beside}" VerticalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
