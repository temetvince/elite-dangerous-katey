<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Katey.Ui</RootNamespace>
    <AssemblyName>katey</AssemblyName>
    <Description>Desktop window for planning Elite Dangerous engineering against a live material inventory.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\katey.ico</ApplicationIcon>
    <!-- LibraryImport, used for the rail window's click-through style, generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <!-- Avalonia's Linux backend pulls in a Tmds.DBus.Protocol release that carries advisory
         GHSA-xrw6-gwf8-vvr9; referencing the current release directly lifts the transitive version. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Katey.App\Katey.App.csproj" />
    <ProjectReference Include="..\Katey.Localization\Katey.Localization.csproj" />
  </ItemGroup>

</Project>
