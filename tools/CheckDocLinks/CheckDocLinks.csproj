<Project Sdk="Microsoft.NET.Sdk">

  <!-- A small dev/CI utility that verifies every relative Markdown link and heading anchor across the
       repo's docs resolves — the failure mode the split-guide + per-project-README structure is prone to
       (a moved file, a renamed #anchor). Pure BCL, no dependencies. See README.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
